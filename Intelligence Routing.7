# - ROUTING 

def process_logistic_plan():
    selected_origin = origin_combo.get()
    if not system_data["orders"]:
        return messagebox.showwarning("Notice", "There are no orders.")
    
    # GROUPING BY MACRO-ZONE
    corridor_groups = {}
    for p in system_data["orders"]:
        zone = p["zone"].title()
        corridor = MACRO_ZONES.get(zone, f"Special Route ({zone})")
        if corridor not in corridor_groups:
            corridor_groups[corridor] = []
        corridor_groups[corridor].append(p)
        
    trucks = [v for v in system_data["fleet"] if v["status"] == "available"]
    random.shuffle(trucks) 
    
    kpi_viewer.delete("1.0", tk.END)
    output_text = f"=== DYNAMIC ROUTE PLAN | ORIGIN: {selected_origin.upper()} ===\n"
    output_text += f"GENERATION DATE: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n"
    
    for corridor, corridor_orders in corridor_groups.items():
        output_text += f"🛣️ MACRO-ZONE: {corridor.upper()} | Total Clients: {len(corridor_orders)}\n"
        output_text += "-"*75 + "\n"
        
        #.UB-GROUPING BASED ON ROUTE MASTER
        planned_sub_routes = {}
        for order in corridor_orders:
            exact_route = obtain_consolidated_route(order["zone"])
            if exact_route not in planned_sub_routes:
                planned_sub_routes[exact_route] = []
            planned_sub_routes[exact_route].append(order)

        for route_name, order_list in planned_sub_routes.items():
            output_text += f"    ➔ Designated Corridor: {route_name}\n"
            
            attempts = 0
            using_virtual_fleet = False
            
            order_list.sort(key=lambda x: calculate_distance(selected_origin, x["zone"]))
            
            while order_list:
                if not trucks and not using_virtual_fleet:
                    using_virtual_fleet = True
                    
                if using_virtual_fleet:
                    total_kg = sum(p["kg"] for p in order_list)
                    total_m3 = sum(p["m3"] for p in order_list)
                    
                    templates = [
                        {"type": "Pick-up 150", "cap_kg": 1500, "cap_m3": 4.0},
                        {"type": "Triton 350", "cap_kg": 3500, "cap_m3": 12.0},
                        {"type": "Camión 750", "cap_kg": 7500, "cap_m3": 25.0},
                        {"type": "Gandola", "cap_kg": 24000, "cap_m3": 60.0}
                    ]
                    
                    ideal_truck = templates[-1]
                    for t in templates:
                        if t["cap_kg"] >= total_kg and t["cap_m3"] >= total_m3:
                            ideal_truck = t
                            break
                            
                    if order_list[0]["kg"] > ideal_truck["cap_kg"] or order_list[0]["m3"] > ideal_truck["cap_m3"]:
                        ideal_truck = {
                            "type": "Special Cargo Vehicle",
                            "cap_kg": order_list[0]["kg"] * 1.1,
                            "cap_m3": order_list[0]["m3"] * 1.1
                        }

                    truck = {
                        "id": "REQUIRED",
                        "type": ideal_truck["type"],
                        "cap_kg": ideal_truck["cap_kg"],
                        "cap_m3": ideal_truck["cap_m3"],
                        "company": "⚠️ NEEDS SUBCONTRACTING"
                    }
                else:
                    truck = trucks.pop(0)

                rem_kg, rem_m3 = truck["cap_kg"], truck["cap_m3"]
                stops, remaining_list = [], []
                loaded_kg = 0
                
                for order in order_list:
                    if order["kg"] <= rem_kg and order["m3"] <= rem_m3:
                        rem_kg -= order["kg"]
                        rem_m3 -= order["m3"]
                        loaded_kg += order["kg"]
                        stops.append(order)
                    else: 
                        remaining_list.append(order)
                
                if stops:
                    optimized_route = []
                    current_location = selected_origin
                    pending = list(stops)
                    total_distance = 0
                    
                    while pending:
                        next_stop = min(pending, key=lambda x: calculate_distance(current_location, x["zone"]))
                        optimized_route.append(next_stop)
                        total_distance += calculate_distance(current_location, next_stop["zone"])
                        pending.remove(next_stop)
                        current_location = next_stop["zone"]
                    
                    efficiency_ratio = (loaded_kg / truck["cap_kg"]) * 100
                    
                    if using_virtual_fleet:
                        output_text += f"      🆘 SUGGESTED ADDITIONAL VEHICLE: {truck['type']}\n"
                        output_text += f"      🏢 Company: {truck['company']}\n"
                    else:
                        output_text += f"      🚍 VEHICLE: {truck['type']} [{truck['id']}] | Company: {truck['company']}\n"
                        
                    output_text += f"      📊 Load Efficiency: {loaded_kg}kg / {truck['cap_kg']}kg ({efficiency_ratio:.1f}%)\n"
                    
                    for idx, p in enumerate(optimized_route, 1):
                        output_text += f"         ➔ Stop {idx}: {p['zone']} | {p['client']} ({p['kg']}kg)\n"
                    output_text += f"      🏁 Route Cost (Weighted Dist.): {int(total_distance)}\n\n"
                    attempts = 0
                else:
                    if not using_virtual_fleet:
                        trucks.append(truck)
                        attempts += 1
                        if attempts >= len(trucks):
                            output_text += f"      ⚠️ WARNING: Current fleet cannot support the {order_list[0]['client']} order. Calculating subcontracting option...\n\n"
                            using_virtual_fleet = True
                    else:
                        output_text += f"      ❌ CRITICAL ERROR: Unable to assign {order_list[0]['client']} (Check dimensions).\n\n"
                        remaining_list.pop(0)

                order_list = remaining_list
        output_text += "="*75 + "\n\n"
        
    kpi_viewer.insert(tk.END, output_text)
    
    if messagebox.askyesno("Export Plan", "Do you want to export this route plan to a .txt file?"):
        save_report(output_text)

