    selected = fleet_table.selection()
    
    if not selected: return
        
    message = f"Delete the {len(selected)} selected units?" if len(selected) > 1 else "Delete the selected unit?"
    
    if messagebox.askyesno("Confirm", message):
    
        v_ids = [fleet_table.item(item)["values"][0] for item in selected]
        
        system_data["fleet"] = [c for c in system_data["fleet"] if c["id"] not in v_ids]
        save_db()
        refresh_fleet_ui()

def import_from_text():
    # Assuming orders_paste_box is your variable name
    text = orders_paste_box.get("1.0", tk.END).strip()
    
    lines = text.split("\n")[1:] if "Client" in text else text.split("\n")
    if not lines or not text: return
    
    success, errors = 0, 0
    for line in lines:
        line = line.strip()
        if not line: continue
        
        parts = [p.strip() for p in (line.split(",") if "," in line else line.split("\t"))]
        if len(parts) >= 3:
            try:
                weight = float(parts[2])
                vol = float(parts[3]) if len(parts) >= 4 else round(weight * 0.0015, 2)
                
                zone_input = parts[1].title()
                if zone_input not in COORDINATES_MAP:
                    messagebox.showwarning("Unknown Zone", f"The city '{zone_input}' is not registered on the map. Check spelling.")
                    errors += 1
                    continue

                system_data["orders"].append({"client": parts[0], "zone": zone_input, "kg": weight, "m3": vol})
                success += 1
            except ValueError: errors += 1
    save_db(); refresh_orders_ui(); orders_paste_box.delete("1.0", tk.END)
    messagebox.showinfo("Orders Import", f"Processed: {success} | Errors or Unknowns: {errors}")
    
