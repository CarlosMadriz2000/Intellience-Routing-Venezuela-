def import_fleet_text():
    # Assuming fleet_paste_box is your variable name
    text = fleet_paste_box.get("1.0", tk.END).strip()
    lines = text.split("\n")[1:] if "Plate" in text else text.split("\n")
    if not lines or not text: return
    
    success, errors = 0, 0
    for line in lines:
        line = line.strip()
        if not line: continue
        
        parts = [p.strip() for p in (line.split(",") if "," in line else line.split("\t"))]
        if len(parts) >= 5:
            try:
                v_id = parts[0].upper()
                v_type = parts[1]
                
                v_kg = float(parts[2])
                
                v_m3 = float(parts[3])
                v_company = parts[4]

                if any(c["id"] == v_id for c in system_data["fleet"]):
                    continue

                system_data["fleet"].append({"id": v_id, "type": v_type, "cap_kg": v_kg, "cap_m3": v_m3, "company": v_company, "status": "Available"})
                success += 1
            except ValueError: errors += 1
    save_db(); refresh_fleet_ui(); fleet_paste_box.delete("1.0", tk.END)
    messagebox.showinfo("Fleet Import", f"Units registered: {success} | Errors/Duplicates: {errors}")

