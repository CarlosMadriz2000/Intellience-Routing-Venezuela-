def obtain_consolidated_route(zone_city):
    zone_clean = zone_city.upper().strip()
    
    # Search for Sector
    for route in MASTER_ROUTES:
        for sector in route["sectors"]:
            if sector in zone_clean:
                return f"{route['destination']} ({' / '.join(route['sectors'][:3])}...)"
                
    # - Backup for General Destination
    for route in MASTER_ROUTES:
        if route["destination"] in zone_clean:
            return f"{route['destination']} General"
            
    return f"Special Route ({zone_city})"


def calculate_distance(c1, c2):
    c1, c2 = c1.title(), c2.title()
    p1 = COORDINATES_MAP.get(c1, (0, 0))
    p2 = COORDINATES_MAP.get(c2, (0, 0))
    
    distance = math.sqrt((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2)
    
    critical_routes = [
        {"nodes": {"Maracaibo", "Puerto Cabello"}, "multiplicator": 3.0}, 
        {"nodes": {"Maracaibo", "Valencia"}, "multiplicator": 2.8},        
        {"nodes": {"Maracaibo", "Caracas"}, "multiplicator": 3.5},        
        {"nodes": {"San Cristobal", "Caracas"}, "multiplicator": 3.8},
        {"nodes": {"Santa Elena De Uairen", "Maracaibo"}, "multiplicator": 5.0},
        {"nodes": {"Porlamar", "Valencia"}, "multiplicator": 4.5} # Ferry penalty
    ]
    
    actual_route = {c1, c2}
    for route in critical_routes:
        if actual_route == route["nodes"]:
            return distance * route["multiplicator"]
            
    factors = {
        "CARACAS_TRAFFIC": 1.3,
        "INTER_EJE_LARGE": 1.5,
        "Capital": 1.25,
        "Centro": 1.0,      
        "Andes": 1.4,       
        "Occidente": 1.2,
        "Centro Occidente": 1.1,
        "Oriente Norte": 1.2,
        "Oriente Sur": 1.35        
    }
    
    if "Caracas" in [c1, c2]:
        distance *= factors["CARACAS_TRAFFIC"]
        
    eje1 = MACRO_ZONES.get(c1, "Special")
    eje2 = MACRO_ZONES.get(c2, "Special")
    
    # Penalty
    if eje1 != eje2 and eje1 != "Special" and eje2 != "Special":
        distance *= factors["INTER_EJE_LARGE"]
    elif eje1 in factors:
    
        distance *= factors[eje1]
        
    return distance
    
# DATA MANAGEMENT AND EXPORT / THIS THE LAST LINE CONTINUE HERE

def initialize_db():
    global system_data
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                if "fleet" in loaded and "orders" in loaded:
                    system_data = loaded
        except Exception:
            pass
    else:
        save_db()

def save_db():
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(system_data, f, indent=4)

def save_report(content):
    file_name = f"Logistics_Report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
    
    try:
        with open(file_name, "w", encoding="utf-8") as f:
            f.write(content)
        messagebox.showinfo("Successful Export", f"The route plan was saved as:\n\n{file_name}")
    except Exception as e:
        messagebox.showerror("Error", f"Could not save the report: {e}")

