def obtener_ruta_consolidada(zona_ciudad):
    zona_limpia = zona_ciudad.upper().strip()
    
    # 1. Búsqueda por Sector Exacto
    for ruta in MAESTRA_RUTAS:
        for sector in ruta["sectores"]:
            if sector in zona_limpia:
                return f"{ruta['destino']} ({' / '.join(ruta['sectores'][:3])}...)"
                
    # 2. Búsqueda de Respaldo por Destino General
    for ruta in MAESTRA_RUTAS:
        if ruta["destino"] in zona_limpia:
            return f"{ruta['destino']} General"
            
    return f"Ruta Especial ({zona_ciudad})"


def calcular_distancia(c1, c2):
    c1, c2 = c1.title(), c2.title()
    p1 = COORDENADAS_MAPA.get(c1, (0, 0))
    p2 = COORDENADAS_MAPA.get(c2, (0, 0))
    
    distancia = math.sqrt((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2)
    
    rutas_criticas = [
        {"nodos": {"Maracaibo", "Puerto Cabello"}, "multiplicador": 3.0}, 
        {"nodos": {"Maracaibo", "Valencia"}, "multiplicador": 2.8},       
        {"nodos": {"Maracaibo", "Caracas"}, "multiplicador": 3.5},        
        {"nodos": {"San Cristobal", "Caracas"}, "multiplicador": 3.8},
        {"nodos": {"Santa Elena De Uairen", "Maracaibo"}, "multiplicador": 5.0},
        {"nodos": {"Porlamar", "Valencia"}, "multiplicador": 4.5} # Penalización por Ferry
    ]
    
    ruta_actual = {c1, c2}
    for ruta in rutas_criticas:
        if ruta_actual == ruta["nodos"]:
            return distancia * ruta["multiplicador"]
            
    factores = {
        "CARACAS_TRAFICO": 1.3,
        "INTER_EJE_LARGA": 1.5,
        "Capital": 1.25,
        "Centro": 1.0,      
        "Andes": 1.4,       
        "Occidente": 1.2,
        "Centro Occidente": 1.1,
        "Oriente Norte": 1.2,
        "Oriente Sur": 1.35        
    }
    
    if "Caracas" in [c1, c2]:
        distancia *= factores["CARACAS_TRAFICO"]
        
    eje1 = MACRO_ZONAS.get(c1, "Especial")
    eje2 = MACRO_ZONAS.get(c2, "Especial")
    
    # Penalización por cruce de macrozonas distintas
    if eje1 != eje2 and eje1 != "Especial" and eje2 != "Especial":
        distancia *= factores["INTER_EJE_LARGA"]
    elif eje1 in factores:
        distancia *= factores[eje1]
        
    return distancia
