def importar_flota_texto():
    texto = caja_pegado_flota.get("1.0", tk.END).strip()
    lineas = texto.split("\n")[1:] if "Placa" in texto else texto.split("\n")
    if not lineas or not texto: return
    
    exitos, errores = 0, 0
    for linea in lineas:
        linea = linea.strip()
        if not linea: continue
        partes = [p.strip() for p in (linea.split(",") if "," in linea else linea.split("\t"))]
        if len(partes) >= 5:
            try:
                v_id = partes[0].upper()
                v_tipo = partes[1]
                v_kg = float(partes[2])
                v_m3 = float(partes[3])
                v_empresa = partes[4]

                if any(c["id"] == v_id for c in datos_sistema["flota"]):
                    continue

                datos_sistema["flota"].append({"id": v_id, "tipo": v_tipo, "cap_kg": v_kg, "cap_m3": v_m3, "empresa": v_empresa, "estado": "Disponible"})
                exitos += 1
            except ValueError: errores += 1
    salvar_bd(); refrescar_flota_ui(); caja_pegado_flota.delete("1.0", tk.END)
    messagebox.showinfo("Importación Flota", f"Unidades registradas: {exitos} | Errores/Duplicados: {errores}")

def eliminar_vehiculo():
    seleccionados = tabla_flota.selection()
    if not seleccionados: 
        return
        
    mensaje = f"¿Eliminar las {len(seleccionados)} unidades seleccionadas?" if len(seleccionados) > 1 else "¿Eliminar la unidad seleccionada?"
    
    if messagebox.askyesno("Confirmar", mensaje):
        v_ids = [tabla_flota.item(item)["values"][0] for item in seleccionados]
        datos_sistema["flota"] = [c for c in datos_sistema["flota"] if c["id"] not in v_ids]
        salvar_bd()
        refrescar_flota_ui()

def importar_desde_texto():
    texto = caja_pegado.get("1.0", tk.END).strip()
    lineas = texto.split("\n")[1:] if "Cliente" in texto else texto.split("\n")
    if not lineas or not texto: return
    
    exitos, errores = 0, 0
    for linea in lineas:
        linea = linea.strip()
        if not linea: continue
        partes = [p.strip() for p in (linea.split(",") if "," in linea else linea.split("\t"))]
        if len(partes) >= 3:
            try:
                peso = float(partes[2])
                vol = float(partes[3]) if len(partes) >= 4 else round(peso * 0.0015, 2)
                
                zona_ingresada = partes[1].title()
                if zona_ingresada not in COORDENADAS_MAPA:
                    messagebox.showwarning("Zona Desconocida", f"La ciudad '{zona_ingresada}' no está registrada en el mapa. Revisa la ortografía (ej: 'San Cristobal' en vez de 'San Cristóbal').")
                    errores += 1
                    continue

                datos_sistema["pedidos"].append({"cliente": partes[0], "zona": zona_ingresada, "kg": peso, "m3": vol})
                exitos += 1
            except ValueError: errores += 1
    salvar_bd(); refrescar_pedidos_ui(); caja_pegado.delete("1.0", tk.END)
    messagebox.showinfo("Importación Pedidos", f"Procesados: {exitos} | Errores o Desconocidos: {errores}")

