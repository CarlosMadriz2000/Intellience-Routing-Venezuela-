def procesar_logistica_final():
    origen_seleccionado = combo_origen.get()
    if not datos_sistema["pedidos"]: return messagebox.showwarning("Aviso", "No hay pedidos en cola.")
    
    # 1. AGRUPACIÓN PRIMARIA POR MACRO-ZONA
    grupos_por_corredor = {}
    for p in datos_sistema["pedidos"]:
        zona = p["zona"].title()
        corredor = MACRO_ZONAS.get(zona, f"Ruta Especial ({zona})")
        if corredor not in grupos_por_corredor: grupos_por_corredor[corredor] = []
        grupos_por_corredor[corredor].append(p)
        
    camiones = [v for v in datos_sistema["flota"] if v["estado"] == "Disponible"]
    random.shuffle(camiones) 
    
    visor_kpi.delete("1.0", tk.END)
    texto_salida = f"=== PLAN DE RUTA DINÁMICA | SALIDA: {origen_seleccionado.upper()} ===\n"
    texto_salida += f"FECHA DE GENERACIÓN: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n"
    
    for corredor, pedidos_corredor in grupos_por_corredor.items():
        texto_salida += f"🛣️ MACRO-ZONA: {corredor.upper()} | Clientes Total: {len(pedidos_corredor)}\n"
        texto_salida += "-"*75 + "\n"
        
        # 2. SUB-AGRUPACIÓN BASADA EN HOJA DE RUTAS
        sub_rutas_planificadas = {}
        for ped in pedidos_corredor:
            ruta_exacta = obtener_ruta_consolidada(ped["zona"])
            if ruta_exacta not in sub_rutas_planificadas:
                sub_rutas_planificadas[ruta_exacta] = []
            sub_rutas_planificadas[ruta_exacta].append(ped)

        for nombre_ruta, lista_pedidos in sub_rutas_planificadas.items():
            texto_salida += f"   ➔ Corredor Designado: {nombre_ruta}\n"

            intentos = 0
            usando_flota_virtual = False
            
            lista_pedidos.sort(key=lambda p: calcular_distancia(origen_seleccionado, p["zona"]))
            
            while lista_pedidos:
                if not camiones and not usando_flota_virtual:
                    usando_flota_virtual = True
                    
                if usando_flota_virtual:
                    kg_total = sum(p["kg"] for p in lista_pedidos)
                    m3_total = sum(p["m3"] for p in lista_pedidos)
                    
                    plantillas = [
                        {"tipo": "Pick-up 150", "cap_kg": 1500, "cap_m3": 4.0},
                        {"tipo": "Triton 350", "cap_kg": 3500, "cap_m3": 12.0},
                        {"tipo": "Camión 750", "cap_kg": 7500, "cap_m3": 25.0},
                        {"tipo": "Gandola", "cap_kg": 24000, "cap_m3": 60.0}
                    ]
                    
                    camion_ideal = plantillas[-1]
                    for t in plantillas:
                        if t["cap_kg"] >= kg_total and t["cap_m3"] >= m3_total:
                            camion_ideal = t
                            break
                            
                    if lista_pedidos[0]["kg"] > camion_ideal["cap_kg"] or lista_pedidos[0]["m3"] > camion_ideal["cap_m3"]:
                        camion_ideal = {
                            "tipo": "Vehículo Carga Especial",
                            "cap_kg": lista_pedidos[0]["kg"] * 1.1,
                            "cap_m3": lista_pedidos[0]["m3"] * 1.1
                        }

                    camion = {
                        "id": "REQUERIDO",
                        "tipo": camion_ideal["tipo"],
                        "cap_kg": camion_ideal["cap_kg"],
                        "cap_m3": camion_ideal["cap_m3"],
                        "empresa": "⚠️ NECESITA SUBCONTRATAR"
                    }
                else:
                    camion = camiones.pop(0)

                kg_rest, m3_rest = camion["cap_kg"], camion["cap_m3"]
                paradas, lista_remanente = [], []
                kg_cargados = 0
                
                for pedido in lista_pedidos:
                    if pedido["kg"] <= kg_rest and pedido["m3"] <= m3_rest:
                        kg_rest -= pedido["kg"]; m3_rest -= pedido["m3"]
                        kg_cargados += pedido["kg"]
                        paradas.append(pedido)
                    else: 
                        lista_remanente.append(pedido)
                
                if paradas:
                    ruta_optimizada = []
                    ubicacion_actual = origen_seleccionado
                    pendientes = list(paradas)
                    distancia_total = 0
                    
                    while pendientes:
                        siguiente = min(pendientes, key=lambda x: calcular_distancia(ubicacion_actual, x["zona"]))
                        ruta_optimizada.append(siguiente)
                        distancia_total += calcular_distancia(ubicacion_actual, siguiente["zona"])
                        pendientes.remove(siguiente)
                        ubicacion_actual = siguiente["zona"]
                    
                    ratio_eficiencia = (kg_cargados / camion["cap_kg"]) * 100
                    
                    if usando_flota_virtual:
                        texto_salida += f"      🆘 VEHÍCULO ADICIONAL SUGERIDO: {camion['tipo']}\n"
                        texto_salida += f"      🏢 Empresa: {camion['empresa']}\n"
                    else:
                        texto_salida += f"      🚍 VEHÍCULO: {camion['tipo']} [{camion['id']}] | Empresa: {camion['empresa']}\n"
                        
                    texto_salida += f"      📊 Eficiencia de Carga: {kg_cargados}kg / {camion['cap_kg']}kg ({ratio_eficiencia:.1f}%)\n"
                    
                    for idx, p in enumerate(ruta_optimizada, 1):
                        texto_salida += f"         ➔ Parada {idx}: {p['zona']} | {p['cliente']} ({p['kg']}kg)\n"
                    texto_salida += f"      🏁 Costo de Ruta (Dist. Ponderada): {int(distancia_total)}\n\n"
                    intentos = 0
                else:
                    if not usando_flota_virtual:
                        camiones.append(camion)
                        intentos += 1
                        if intentos >= len(camiones):
                            texto_salida += f"      ⚠️ AVISO: La flota física actual no soporta el tamaño del pedido de {lista_pedidos[0]['cliente']}. Calculando opción para subcontratar...\n\n"
                            usando_flota_virtual = True
                    else:
                        texto_salida += f"      ❌ ERROR CRÍTICO: Imposible asignar {lista_pedidos[0]['cliente']} (Revisar dimensiones).\n\n"
                        lista_remanente.pop(0)

                lista_pedidos = lista_remanente
        texto_salida += "="*75 + "\n\n"
        
    visor_kpi.insert(tk.END, texto_salida)
    
    if messagebox.askyesno("Exportar Plan", "¿Deseas exportar este plan de ruta a un archivo .txt para enviarlo a los transportistas?"):
        guardar_informe(texto_salida)

