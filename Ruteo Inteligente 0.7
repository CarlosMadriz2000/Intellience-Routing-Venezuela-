def inicializar_bd():
    global datos_sistema
    if os.path.exists(ARCHIVO_DATOS):
        try:
            with open(ARCHIVO_DATOS, "r", encoding="utf-8") as f:
                cargados = json.load(f)
                if "flota" in cargados and "pedidos" in cargados:
                    datos_sistema = cargados
        except Exception:
            pass
    else:
        salvar_bd()

def salvar_bd():
